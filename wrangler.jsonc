{
	// Static assets only, no Worker script: every route is prerendered.
	"name": "isthisaromanroad",
	"compatibility_date": "2026-11-01",
	// Only serve on the custom domain (no duplicate content on *.workers.dev).
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./build",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
