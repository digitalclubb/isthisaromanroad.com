{
	"name": "isthisaromanroad",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome format --write .",
		"fix": "biome check --write .",
		"data:build": "node --experimental-strip-types scripts/build-roads.ts",
		"data:smoke": "tsx scripts/smoke-test.ts",
		"data:regions": "tsx scripts/build-regions.ts",
		"data:counties": "tsx scripts/build-counties.ts",
		"icons:build": "tsx scripts/generate-icons.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^22.20.5",
		"@vite-pwa/sveltekit": "^1.1.0",
		"proj4": "^2.23.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^6.4.6"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/cormorant-garamond": "^5.3.0",
		"@turf/distance": "^7.4.0",
		"@turf/helpers": "^7.4.0",
		"@turf/nearest-point-on-line": "^7.4.0",
		"@vercel/analytics": "^2.0.1",
		"html-to-image": "^1.11.13",
		"maplibre-gl": "^5.24.1"
	},
	"packageManager": "pnpm@10.30.3",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild"
		]
	}
}
